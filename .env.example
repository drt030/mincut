# Public app origin used for local previews and generated links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local operator harness only. Do not set these in production.
OPERATOR_WRITES=0
NEXT_PUBLIC_OPERATOR_MODE=0

# Stripe server key. Required only when handling /unlock checkout returns.
STRIPE_SECRET_KEY=

# Required for entitlement cookie signing and verification.
# Use a long random value in deployed environments. Do not leave empty when
# enabling paid founding checkout.
ENTITLEMENT_SECRET=

# Founding all-access is the only paid price that can grant entitlement today.
STRIPE_PRICE_FOUNDING=
NEXT_PUBLIC_STRIPE_LINK_FOUNDING=

# Do not configure humanoid/power Stripe links or prices in production until
# their /d/<slug> routes, graph data, human review state, and payment target
# are all ready. If old STRIPE_PRICE_HUMANOID or STRIPE_PRICE_POWER values are
# present, /unlock treats them as disabled and grants no entitlement.
# STRIPE_PRICE_HUMANOID=
# STRIPE_PRICE_POWER=
# NEXT_PUBLIC_STRIPE_LINK_HUMANOID=
# NEXT_PUBLIC_STRIPE_LINK_POWER=
