# Public app origin used for local previews and generated links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local operator harness only. Do not set these in production.
OPERATOR_WRITES=0
NEXT_PUBLIC_OPERATOR_MODE=0

# Stripe server key. Required only when handling /unlock checkout returns.
STRIPE_SECRET_KEY=

# Required for entitlement cookie signing and verification.
# Use a random value of at least 32 characters in deployed environments. Do
# not leave empty when enabling paid founding checkout.
ENTITLEMENT_SECRET=

# Server-side launch switch for every paid surface. Checkout links stay hidden,
# existing entitlement cookies stay inactive, and /unlock refuses to call Stripe
# unless this exact flag is explicitly enabled after paid-launch QA.
ENABLE_PAID_UNLOCKS=0

# Public support mailbox shown in the purchase/refund policy. Verify that it
# can receive replies before enabling paid unlocks; paid builds fail closed
# when this is missing or invalid.
SUPPORT_EMAIL=

# Founding all-access is the only paid price that can grant entitlement today.
# Configure the Stripe Payment Link success URL as:
#   https://<your-domain>/unlock?session_id={CHECKOUT_SESSION_ID}
# Before a paid deployment, run `npm run verify:paid-release`; it verifies the
# live $9 one-time price, matching active Payment Link, and exact success URL.
STRIPE_PRICE_FOUNDING=
NEXT_PUBLIC_STRIPE_LINK_FOUNDING=

# Do not configure humanoid/power Stripe links or prices in production until
# their /d/<slug> routes, graph data, human review state, and payment target
# are all ready. If old STRIPE_PRICE_HUMANOID or STRIPE_PRICE_POWER values are
# present, /unlock treats them as disabled and grants no entitlement.
# STRIPE_PRICE_HUMANOID=
# STRIPE_PRICE_POWER=
# NEXT_PUBLIC_STRIPE_LINK_HUMANOID=
# NEXT_PUBLIC_STRIPE_LINK_POWER=
